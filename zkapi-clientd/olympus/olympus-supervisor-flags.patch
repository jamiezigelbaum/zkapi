+	switch {
+	case relayURL == "":
+		return "direct", ""
+	case err != nil:
+		return "invalid", ""
+	case u.Scheme == "socks5":
+		return "socks5", u.Host
+	default:
+		return "wisp", u.Scheme + "://" + u.Host
+	}
+}
