new file mode 100644
index 0000000..ca8cc95
--- /dev/null
+++ b/zkapi-clientd/internal/zkapi/companion_custody.go
@@ -0,0 +1,132 @@
+package zkapi
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"time"
+)
+
+// CompanionCustody allows a managed wallet bridge connection only when the
+// exact supervised child owns the server side of that already-connected TCP
+// socket. No HTTP bytes are available to the peer until this proof succeeds.
+type CompanionCustody struct {
+	mu     sync.Mutex
+	active *companionCustodyProcess
+}
+
+type companionCustodyProcess struct {
+	pid      int
+	identity companionProcessIdentity
+}
+
+type companionProcessIdentity interface {
+	exited() (bool, error)
+	close()
+}
+
+// CompanionCustodySupported reports whether this build can bind a connected
+// socket to the lifetime of a supervised companion process.
+func CompanionCustodySupported() bool { return companionCustodyPlatformSupported }
+
+// NewCompanionCustody creates inactive custody. Activate must be called only
+// after the supervised child has started successfully.
+func NewCompanionCustody() (*CompanionCustody, error) {
+	if !CompanionCustodySupported() {
+		return nil, errors.New("managed companion custody is not supported on this platform")
+	}
+	return &CompanionCustody{}, nil
+}
+
+// Activate binds this custody instance to one exact live child lifetime.
+func (c *CompanionCustody) Activate(pid int) error {
+	if c == nil || pid <= 0 {
+		return errors.New("managed companion custody requires a started child")
+	}
+	identity, err := newCompanionProcessIdentity(pid)
+	if err != nil {
+		return errors.New("could not establish managed companion process custody")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.active != nil {
+		identity.close()
+		return errors.New("managed companion custody is already active")
+	}
+	c.active = &companionCustodyProcess{pid: pid, identity: identity}
+	return nil
+}
+
+// Retire removes authority for pid. It is safe to call more than once. The
+// process identity guard remains active until retirement, so a reaped PID
+// cannot silently transfer custody to a later process.
+func (c *CompanionCustody) Retire(pid int) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.active == nil || c.active.pid != pid {
+		return
+	}
+	c.active.identity.close()
+	c.active = nil
+}
+
+// IsActive reports whether the exact child lifetime is still held. It is used
+// for in-process supervised startup readiness so no API credential is sent to
+// an unverified process occupying the daemon's own listen port.
+func (c *CompanionCustody) IsActive() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.active == nil {
+		return false
+	}
+	exited, err := c.active.identity.exited()
+	return err == nil && !exited
+}
+
+// DialContext is installed directly on the wallet-only http.Transport. It
+// dials without sending application bytes, proves that the supervised child
+// owns the reverse endpoint of this exact connection, then hands this same
+// socket to net/http. A listener swap cannot replace an established socket.
+func (c *CompanionCustody) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	if c == nil {
+		return nil, errors.New("managed companion custody is unavailable")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.active == nil {
+		return nil, errors.New("managed companion custody is inactive")
+	}
+	exited, err := c.active.identity.exited()
+	if err != nil || exited {
+		return nil, errors.New("managed companion is no longer in custody")
+	}
+	connection, err := (&net.Dialer{Timeout: 5 * time.Second}).DialContext(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	fail := func() (net.Conn, error) {
+		_ = connection.Close()
+		return nil, errors.New("wallet connection owner could not be verified")
+	}
+	local, localOK := connection.LocalAddr().(*net.TCPAddr)
+	remote, remoteOK := connection.RemoteAddr().(*net.TCPAddr)
+	if !localOK || !remoteOK {
+		return fail()
+	}
+	owned, err := companionOwnsConnectedSocket(ctx, c.active.pid, local, remote)
+	if err != nil || !owned {
+		return fail()
+	}
+	exited, err = c.active.identity.exited()
+	if err != nil || exited {
+		return fail()
+	}
+	return connection, nil
+}
diff --git a/zkapi-clientd/internal/zkapi/companion_custody_darwin.go b/zkapi-clientd/internal/zkapi/companion_custody_darwin.go
new file mode 100644
index 0000000..3a46bc0
--- /dev/null
+++ b/zkapi-clientd/internal/zkapi/companion_custody_darwin.go
@@ -0,0 +1,132 @@
+//go:build darwin
+
+package zkapi
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"net/netip"
+	"os/exec"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const companionCustodyPlatformSupported = true
+
+type darwinCompanionProcessIdentity struct {
+	kqueue int
+	dead   bool
+}
+
+func newCompanionProcessIdentity(pid int) (companionProcessIdentity, error) {
+	kqueue, err := unix.Kqueue()
+	if err != nil {
+		return nil, err
+	}
+	change := unix.Kevent_t{
+		Ident:  uint64(pid),
+		Filter: unix.EVFILT_PROC,
+		Flags:  unix.EV_ADD | unix.EV_ENABLE | unix.EV_CLEAR,
+		Fflags: unix.NOTE_EXIT,
+	}
+	if _, err := unix.Kevent(kqueue, []unix.Kevent_t{change}, nil, nil); err != nil {
+		_ = unix.Close(kqueue)
+		return nil, err
+	}
+	return &darwinCompanionProcessIdentity{kqueue: kqueue}, nil
+}
+
+func (p *darwinCompanionProcessIdentity) exited() (bool, error) {
+	if p.dead {
+		return true, nil
+	}
+	events := make([]unix.Kevent_t, 1)
+	timeout := unix.Timespec{}
+	n, err := unix.Kevent(p.kqueue, nil, events, &timeout)
+	if n != 0 {
+		p.dead = true
+	}
+	return p.dead, err
+}
+
+func (p *darwinCompanionProcessIdentity) close() { _ = unix.Close(p.kqueue) }
+
+func companionOwnsConnectedSocket(ctx context.Context, pid int, local, remote *net.TCPAddr) (bool, error) {
+	wantLocal, ok := tcpAddrPort(remote)
+	if !ok {
+		return false, nil
+	}
+	wantRemote, ok := tcpAddrPort(local)
+	if !ok {
+		return false, nil
+	}
+	// A caller may have no deadline. Keep process retirement bounded even if
+	// lsof itself stalls while DialContext holds the custody mutex.
+	verifyCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	// connect(2) may complete just before accept(2) installs the peer's file
+	// descriptor. Bound the ownership probe without ever sending bridge bytes.
+	for attempt := 0; attempt < 20; attempt++ {
+		output, err := exec.CommandContext(verifyCtx, "/usr/sbin/lsof", "-nP", "-a", "-p", strconv.Itoa(pid), "-iTCP", "-sTCP:ESTABLISHED", "-F0pnT").Output()
+		if err == nil && lsofHasSocket(output, pid, wantLocal, wantRemote) {
+			return true, nil
+		}
+		if ctx.Err() != nil {
+			return false, ctx.Err()
+		}
+		if verifyCtx.Err() != nil {
+			return false, nil
+		}
+		timer := time.NewTimer(10 * time.Millisecond)
+		select {
+		case <-verifyCtx.Done():
+			timer.Stop()
+			if ctx.Err() != nil {
+				return false, ctx.Err()
+			}
+			return false, nil
+		case <-timer.C:
+		}
+	}
+	return false, nil
+}
+
+func tcpAddrPort(address *net.TCPAddr) (netip.AddrPort, bool) {
+	ip, ok := netip.AddrFromSlice(address.IP)
+	if !ok || address.Port < 1 || address.Port > 65535 {
+		return netip.AddrPort{}, false
+	}
+	return netip.AddrPortFrom(ip.Unmap(), uint16(address.Port)), true
+}
+
+func lsofHasSocket(output []byte, pid int, wantLocal, wantRemote netip.AddrPort) bool {
+	seenPID := false
+	for _, raw := range bytes.Split(output, []byte{0}) {
+		field := strings.TrimSpace(string(raw))
+		if len(field) < 2 {
+			continue
+		}
+		switch field[0] {
+		case 'p':
+			seenPID = field[1:] == strconv.Itoa(pid)
+		case 'n':
+			if !seenPID {
+				continue
+			}
+			parts := strings.Split(field[1:], "->")
+			if len(parts) != 2 {
+				continue
+			}
+			local, localErr := netip.ParseAddrPort(parts[0])
+			remote, remoteErr := netip.ParseAddrPort(parts[1])
+			if localErr == nil && remoteErr == nil && local.Addr().Unmap() == wantLocal.Addr() && local.Port() == wantLocal.Port() && remote.Addr().Unmap() == wantRemote.Addr() && remote.Port() == wantRemote.Port() {
+				return true
+			}
+		}
+	}
+	return false
+}
